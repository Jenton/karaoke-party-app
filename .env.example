# Copy to .env. Never commit .env.

# YouTube Data API v3 key (only used by the local server for search/playlist import)
YOUTUBE_API_KEY=

# For the public GitHub Pages site the key is a repository *variable* named VITE_YOUTUBE_API_KEY.
# It is visible to anyone, so restrict it to your site's address in Google Cloud (README: "YouTube API key").

# Optional shared song database (Supabase). See README "Shared song database".
# These two are safe to be public; row-level security controls who can edit.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
